<UserControl x:Class="ChestOrMonster.WPF.Templates.ChestControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ChestOrMonster.WPF.Templates"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <Image Source="../Images/ChestIcon.png"/>
        <Button x:Name="OpenChestButton" Grid.Row="1" Content="Открыть" Click="OpenChestButton_OnClick"/>
    </Grid>
</UserControl>
